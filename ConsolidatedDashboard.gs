          </div>
          ${state.allowedNextStates.length > 0
            ? `<div class="next-states">
                <strong>Can transition to:</strong> ${state.allowedNextStates.map(function(s) { return WORKFLOW_STATES[s].name; }).join(', ')}
              </div>`
