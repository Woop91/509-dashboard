  // Create weekly trigger (Sunday at 2 AM)
  ScriptApp.newTrigger('runAutomatedBackup')
    .timeBased()
    .onWeekDay(ScriptApp.WeekDay.SUNDAY)
    .atHour(2)
    .create();

  SpreadsheetApp.getActiveSpreadsheet().toast(
    '✅ Automated weekly backups enabled (Sundays, 2 AM)',
