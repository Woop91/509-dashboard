              <div class="video-desc">${t.description}</div>
              <div class="video-duration">⏱️ ${t.duration}</div>
            </div>
          </div>
        `).join('')}
      </div>
    `;
  });

  const html = `
<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <style>
