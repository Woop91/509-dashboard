 */
function createHTMLPage(title, styles, body, scripts = '') {
  return `<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>${sanitizeHTML(title)}</title>
  <style>${styles}</style>
</head>
<body>
