    ['Est. Value of Wins', '=B2*' + avgWonValue + '+B3*' + (avgWonValue * 0.6), 'Estimated dollar value of won cases'],
    ['Est. Value of Settlements', '=B4*' + avgSettledValue, 'Estimated dollar value of settlements'],
